# Reference checklist of every value the workflow needs. Where you actually put
# these values depends on your n8n setup:
#
# - n8n Cloud (most trial/starter plans): there's no "Variables" screen available,
#   and $env access to arbitrary process env vars is blocked. Use the workflow's
#   "Config" node instead — open it in the n8n UI and paste each value directly
#   into its matching field (adzuna_app_id, adzuna_app_key, etc.). Every other
#   node reads from that one node, so this is the only place you touch.
# - Self-hosted n8n, or an n8n Cloud plan that DOES have Settings > Variables:
#   you can set these as real environment variables / n8n Variables instead, but
#   you'd need to edit each field in workflow.json back to {{$env.VAR_NAME}} or
#   {{$vars.VAR_NAME}} — the shipped file is wired to the Config node by default
#   since that works everywhere.

# --- Adzuna (job source) -> Config node fields: adzuna_app_id, adzuna_app_key, adzuna_country ---
# Free tier: 1,000 calls/mo. Get keys at https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=us

# --- JSearch via RapidAPI (job source) -> Config node field: rapidapi_key ---
# Get a key at https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
RAPIDAPI_KEY=

# --- Search parameters -> Config node fields: target_job_queries, target_job_location ---
# Comma-separated list of role queries. The "Role Queries" node runs Adzuna
# Search and JSearch Search once PER entry here, so this is how you cover
# ops + PM + automation without relying on either API's weak OR support.
# Add/remove roles by editing this field — no other changes needed.
#
# Cost note: each entry multiplies your API usage per run. 3 queries x 4
# runs/day (6h schedule) = ~360 Adzuna calls/month (fine on the 1k free
# tier) and ~360 JSearch calls/month (check your RapidAPI plan's quota —
# free tiers there are often much smaller than Adzuna's). If you're on a
# tight JSearch plan, either trim this list or drop the schedule to every
# 12h.
TARGET_JOB_QUERIES="operations manager,project manager,automation specialist"
TARGET_JOB_LOCATION="Remote"

# --- Anthropic (fit scoring + cover letters) -> Config node field: anthropic_api_key ---
ANTHROPIC_API_KEY=

# --- Candidate profile -> Config node field: candidate_profile ---
# Paste candidate-profile-jerome.md's content as one plain-text value (or fill
# out candidate-profile-template.md fresh for a different candidate).
CANDIDATE_PROFILE=

# --- Airtable -> Config node fields: airtable_base_id, airtable_applications_table ---
# The Airtable Personal Access Token itself is NOT a Config field — it goes into
# n8n's Airtable credential instead (Settings > Credentials, or directly on the
# Airtable nodes). Listed here only for your own reference/rotation tracking.
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_APPLICATIONS_TABLE=Applications

# --- Slack -> Config node field: slack_channel_id ---
# The Slack bot token is NOT a Config field either — it goes into n8n's Slack
# credential. Listed here only for reference/rotation tracking.
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
