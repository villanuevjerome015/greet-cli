# Copy to .env and fill in. These are read via n8n expressions like {{$env.VAR_NAME}}.
# On self-hosted n8n, set these as real environment variables for the n8n process
# (or in docker-compose's `environment:` block). On n8n Cloud, use the built-in
# "Variables" feature instead — $env access to arbitrary process env vars is
# restricted there. Flagging that as an assumption: this build assumes self-hosted
# n8n or n8n Cloud Variables with matching names.

# --- Adzuna (job source) ---
# Free tier: 1,000 calls/mo. Get keys at https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=us

# --- JSearch via RapidAPI (job source) ---
# Get a key at https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
RAPIDAPI_KEY=

# --- Search parameters (used by both Adzuna and JSearch queries) ---
# Comma-separated list of role queries. The "Role Queries" node runs Adzuna
# Search and JSearch Search once PER entry here, so this is how you cover
# ops + PM + automation without relying on either API's weak OR support.
# Add/remove roles by editing this list — no workflow changes needed.
#
# Cost note: each entry multiplies your API usage per run. 3 queries x 4
# runs/day (6h schedule) = ~360 Adzuna calls/month (fine on the 1k free
# tier) and ~360 JSearch calls/month (check your RapidAPI plan's quota —
# free tiers there are often much smaller than Adzuna's). If you're on a
# tight JSearch plan, either trim this list or drop the schedule to every
# 12h.
TARGET_JOB_QUERIES="operations manager,project manager,automation specialist"
TARGET_JOB_LOCATION="Remote"

# --- Anthropic (fit scoring + cover letters) ---
ANTHROPIC_API_KEY=

# --- Candidate profile ---
# Paste candidate-profile-jerome.md's content as one plain-text value (or fill
# out candidate-profile-template.md fresh for a different candidate). Keep
# quotes if your n8n env-loading mechanism needs them for multi-line values.
CANDIDATE_PROFILE=

# --- Airtable ---
# These are only needed if you're NOT using n8n's built-in Airtable credential
# (recommended — see README). Listed here for reference/rotation tracking.
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_APPLICATIONS_TABLE=Applications

# --- Slack ---
# Only needed if you're NOT using n8n's built-in Slack credential (recommended).
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
